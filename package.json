{
  "name": "skydock-monorepo",
  "private": true,
  "author": {
    "name": "Nayan Bagale",
    "email": "nvbagale@yahoo.com"
  },
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --config packages/configs/prettier/prettier.config.js --ignore-path packages/configs/prettier/.prettierignore --write \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "format:check": "prettier --config packages/configs/prettier/prettier.config.js --ignore-path packages/configs/prettier/.prettierignore --check \"**/*.{js,jsx,ts,tsx,json,css,md}\"",
    "db:studio": "yarn workspace @skydock/db run db:studio",
    "db:migrate": "yarn workspace @skydock/db run db:migrate",
    "docker:down": "yarn workspace @skydock/docker-dev run docker:stop"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "yarn@4.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
