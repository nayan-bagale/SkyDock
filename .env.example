# --- Auth / token secrets (server) ---
# Long, random strings used to sign JWTs.
ACCESS_TOKEN_SECRET="youraccesstokensecret"
REFRESH_TOKEN_SECRET="yourrefreshsecret"
EMAIL_VERIFICATION_TOKEN_SECRET="yourverificationtokensecret"

# --- Database (used by server + @skydock/db) ---
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# --- Object storage (S3/MinIO) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="youraccesskey"
AWS_SECRET_ACCESS_KEY="yoursecretaccesskey"
AWS_BUCKET_NAME="skydock"
# The following is an example of a local MinIO server.
# If you are using a different S3-compatible service, replace it with the appropriate endpoint.
# For example, if you are using AWS S3, you can use the following:
# AWS_ENDPOINT="https://s3.amazonaws.com"
AWS_ENDPOINT="http://localhost:9000"

# --- URLs (used by server + web) ---
# Public URL where the API is reachable.
SERVER_URL="http://localhost:3000"
# Public URL where the web client is served.
CLIENT_URL="http://localhost:5173"

# --- Google OAuth (server) ---
# Values from Google Cloud Console OAuth 2.0 credentials.
GOOGLE_CLIENT_ID=__INSERT_CLIENT_ID_HERE__
GOOGLE_CLIENT_SECRET=__INSERT_CLIENT_SECRET_HERE__

# --- Email (SMTP) ---
# If using Gmail, SMTP_USER is the email and SMTP_PASS is an app password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=__yourgmailaddress_
SMTP_PASS=__yourapppassword_

# Optional: use SendGrid instead of SMTP.
# SENDGRID_API_KEY="yourapikey"

# --- Logging (server) ---
# Absolute path where server logs are written in dev/prod.
LOG_FILE_PATH="/tmp/skydock-logs/server.log"

# --- Frontend config (Vite) ---
# Base URL for all API calls from the web app.
VITE_BACKEND_URL="http://localhost:3000/api/v1"
