{
  "extends": "@skydock/configs/typescript/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src",
    "declarations.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}