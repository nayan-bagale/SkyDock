{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "env": ["DATABASE_URL"],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "dependsOn": ["docker:up"],
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": false
    },
    "db:deploy": {
      "cache": false
    },
    "db:studio": {
      "cache": false
    },
    "docker:up": {
      "cache": false
    }
  },
  "globalDependencies": [".env", ".env.dev", ".env.prod"],
  "globalEnv": ["DATABASE_URL", "VITE_BACKEND_URL", "NODE_ENV"]
}
